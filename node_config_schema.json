{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["shard_groups"],
  "properties": {
    "shard_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hash_slots", "nodes"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "hash_slots": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "role",
                "http_address",
                "grpc_address",
                "data_dir"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["primary", "replica"]
                },
                "http_address": {
                  "type": "string"
                },
                "grpc_address": {
                  "type": "string"
                },
                "data_dir": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
