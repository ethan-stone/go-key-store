{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["node"],
  "properties": {
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "http_address": { "type": "string", "examples": ["localhost:8080"] },
        "grpc_address": { "type": "string", "examples": ["localhost:8081"] },
        "data_dir": { "type": "string", "examples": ["data/node1"] }
      },
      "required": ["id", "http_address", "grpc_address", "data_dir"]
    },
    "replication": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["primary", "replica"] },
        "replicas": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["role", "replicas"]
    }
  }
}
